/* Command Center - Clean, Modern Terminal UI Theme */

Screen {
    layout: vertical;
    background: $surface;
    color: $text;
}

#header-bar {
    dock: top;
    height: 3;
    background: $surface-darken-1;
    color: $text;
    padding: 0 1;
    border-bottom: solid $primary-darken-2;
    layout: horizontal;
    align: left middle;
}

#app-title {
    text-style: bold;
    color: $primary;
    margin-right: 2;
}

#app-subtitle {
    color: $text-muted;
}

#output-container {
    height: 1fr;
    background: $surface;
    padding: 1 1 0 1;
}

#output-log {
    height: 100%;
    background: $surface;
    color: $text;
    scrollbar-gutter: stable;
    overflow-y: scroll;
}

#status-bar {
    height: 1;
    dock: bottom;
    background: $surface-darken-2;
    color: $text;
    layout: horizontal;
    padding: 0 1;
}

.status-badge {
    margin-right: 1;
    text-style: bold;
}

#status-shell {
    color: $accent;
}

#status-cwd {
    color: $text-muted;
}

#status-exit {
    color: $text;
}

#status-state {
    color: $warning;
}

#input-container {
    dock: bottom;
    height: 3;
    layout: horizontal;
    background: $surface-darken-1;
    padding: 0 1;
    border-top: solid $primary-darken-2;
    align: left middle;
}

#prompt-symbol {
    width: 3;
    height: 1;
    color: $primary;
    text-style: bold;
    margin-top: 1;
}

#command-input {
    width: 1fr;
    background: transparent;
    border: none;
    color: $text;
    padding: 0;
}

#command-input:focus {
    border: none;
}

Footer {
    background: $surface-darken-3;
    color: $text-muted;
}

/* History Screen Styles */

#history-dialog {
    width: 100%;
    height: 100%;
    background: $surface;
    padding: 1;
}

#history-header {
    height: 3;
    layout: horizontal;
    align: left middle;
    margin-bottom: 1;
}

#history-title {
    width: 22;
    text-style: bold;
    color: $primary;
}

#history-search {
    width: 1fr;
    background: $surface-darken-1;
    border: solid $primary-darken-2;
    padding: 0 1;
}

#history-filter-bar {
    height: 3;
    layout: horizontal;
    margin-bottom: 1;
}

.filter-btn {
    margin-right: 1;
    min-width: 10;
    height: 3;
    border: none;
    background: $surface-darken-1;
    color: $text-muted;
}

.filter-btn:hover {
    background: $surface-lighten-1;
    color: $text;
}

.filter-btn.active {
    background: $primary;
    color: $text;
    text-style: bold;
}

#history-table-container {
    height: 1fr;
    border: solid $surface-darken-2;
    background: $surface;
    margin-bottom: 1;
}

#history-table {
    height: 100%;
    background: $surface;
}

#history-preview-container {
    height: 8;
    background: $surface-darken-1;
    border: solid $surface-darken-2;
    padding: 0 1;
}

#history-preview-title {
    text-style: bold;
    color: $text-muted;
    margin-bottom: 0;
}

#history-preview-log {
    height: 6;
    background: transparent;
    color: $text;
}
