/* Command Center - Premium Modern Terminal UI Design System */

Screen {
    layout: vertical;
    background: $surface;
    color: $text;
}

/* ==========================================================================
   Header Bar
   ========================================================================== */

#header-bar {
    dock: top;
    height: 3;
    background: $surface-darken-1;
    color: $text;
    padding: 0 2;
    border-bottom: solid $surface-lighten-1;
    layout: horizontal;
    align: left middle;
}

#app-title {
    text-style: bold;
    color: $primary;
    margin-right: 1;
}

#app-subtitle {
    color: $text-muted;
}

#header-spacer {
    width: 1fr;
}

#header-hints {
    color: $text-muted;
    text-style: dim;
}

/* ==========================================================================
   Output Log Terminal Area
   ========================================================================== */

#output-container {
    height: 1fr;
    background: $surface;
    padding: 1 2 0 2;
}

#output-log {
    height: 100%;
    background: $surface;
    color: $text;
    scrollbar-gutter: stable;
    overflow-y: scroll;
    scrollbar-size-vertical: 1;
}

/* ==========================================================================
   Status Bar
   ========================================================================== */

#status-bar {
    height: 1;
    dock: bottom;
    background: $surface-darken-2;
    color: $text;
    layout: horizontal;
    padding: 0 2;
    border-top: solid $surface-darken-3;
}

.status-badge {
    margin-right: 2;
    text-style: bold;
}

#status-shell {
    color: $accent;
    background: $surface-darken-1;
    padding: 0 1;
}

#status-cwd {
    color: $text-muted;
}

#status-exit {
    color: $text;
}

#status-state {
    color: $warning;
}

/* ==========================================================================
   Bottom Dock & Command Input
   ========================================================================== */

#bottom-dock {
    dock: bottom;
    height: auto;
}

#input-container {
    height: 3;
    layout: horizontal;
    background: $surface-darken-1;
    padding: 0 2;
    border-top: solid $primary;
    align: left middle;
}

#prompt-symbol {
    width: auto;
    height: 1;
    color: $primary;
    text-style: bold;
    margin-right: 1;
}

#command-input {
    width: 1fr;
    background: transparent;
    border: none;
    color: $text;
    padding: 0;
}

#command-input:focus {
    border: none;
}

/* ==========================================================================
   Auto-Suggest Dropdown
   ========================================================================== */

#suggestions-container {
    display: none;
    max-height: 10;
    height: auto;
    background: $surface-darken-2;
    border-top: solid $accent;
    border-bottom: solid $surface-darken-3;
    padding: 0 1;
}

#suggestions-container.visible {
    display: block;
}

#suggestions-list {
    background: transparent;
    border: none;
    height: auto;
    max-height: 9;
    padding: 0;
    scrollbar-gutter: stable;
}

#suggestions-list > .option-list--option-highlighted {
    background: $primary;
    color: $surface;
    text-style: bold;
}

/* ==========================================================================
   Footer
   ========================================================================== */

Footer {
    background: $surface-darken-3;
    color: $text-muted;
}

/* ==========================================================================
   History Screen Styles
   ========================================================================== */

#history-dialog {
    width: 94%;
    height: 90%;
    background: $surface-darken-1;
    border: solid $primary;
    padding: 1 2;
    align: center middle;
}

#history-header {
    height: 3;
    layout: horizontal;
    align: left middle;
    margin-bottom: 1;
}

#history-title {
    width: 24;
    text-style: bold;
    color: $primary;
}

#history-search {
    width: 1fr;
    background: $surface;
    border: solid $primary-darken-2;
    padding: 0 1;
}

#history-search:focus {
    border: solid $accent;
}

#history-filter-bar {
    height: 3;
    layout: horizontal;
    margin-bottom: 1;
}

.filter-btn {
    margin-right: 1;
    min-width: 12;
    height: 3;
    border: none;
    background: $surface;
    color: $text-muted;
}

.filter-btn:hover {
    background: $surface-lighten-1;
    color: $text;
}

.filter-btn.active {
    background: $primary;
    color: $surface;
    text-style: bold;
}

#history-table-container {
    height: 1fr;
    border: solid $surface-darken-3;
    background: $surface;
    margin-bottom: 1;
}

#history-table {
    height: 100%;
    background: $surface;
}

#history-table > .datatable--header {
    background: $surface-darken-2;
    color: $primary;
    text-style: bold;
}

#history-table > .datatable--cursor {
    background: $primary;
    color: $surface;
    text-style: bold;
}

#history-preview-container {
    height: 8;
    background: $surface;
    border: solid $surface-darken-3;
    padding: 0 1;
}

#history-preview-title {
    text-style: bold;
    color: $text-muted;
}

#history-preview-log {
    height: 6;
    background: transparent;
    color: $text;
}

/* ==========================================================================
   Library Screen Styles
   ========================================================================== */

#library-dialog {
    width: 94%;
    height: 90%;
    background: $surface-darken-1;
    border: solid $accent;
    padding: 1 2;
    align: center middle;
}

#library-header {
    height: 3;
    layout: horizontal;
    align: left middle;
    margin-bottom: 1;
}

#library-title {
    width: 24;
    text-style: bold;
    color: $accent;
}

#library-search {
    width: 1fr;
    background: $surface;
    border: solid $accent-darken-2;
    padding: 0 1;
}

#library-search:focus {
    border: solid $primary;
}

#library-filter-bar {
    height: 3;
    layout: horizontal;
    margin-bottom: 1;
}

.lib-filter-btn {
    margin-right: 1;
    min-width: 12;
    height: 3;
    border: none;
    background: $surface;
    color: $text-muted;
}

.lib-filter-btn:hover {
    background: $surface-lighten-1;
    color: $text;
}

.lib-filter-btn.active {
    background: $accent;
    color: $surface;
    text-style: bold;
}

#btn-add-command {
    margin-left: 1;
}

#library-table-container {
    height: 1fr;
    border: solid $surface-darken-3;
    background: $surface;
    margin-bottom: 1;
}

#library-table {
    height: 100%;
    background: $surface;
}

#library-table > .datatable--header {
    background: $surface-darken-2;
    color: $accent;
    text-style: bold;
}

#library-table > .datatable--cursor {
    background: $accent;
    color: $surface;
    text-style: bold;
}

#library-detail-container {
    height: 8;
    background: $surface;
    border: solid $surface-darken-3;
    padding: 0 1;
}

#library-detail-title {
    text-style: bold;
    color: $text-muted;
}

#library-detail-log {
    height: 6;
    background: transparent;
    color: $text;
}

/* ==========================================================================
   Editor Dialog Styles
   ========================================================================== */

#editor-dialog {
    width: 72;
    height: auto;
    max-height: 90%;
    background: $surface-darken-1;
    border: solid $accent;
    padding: 1 2;
    align: center middle;
}

#editor-title {
    text-style: bold;
    color: $accent;
    margin-bottom: 1;
    text-align: center;
}

.field-label {
    color: $text-muted;
    margin-top: 1;
    text-style: bold;
}

.editor-row {
    height: auto;
    layout: horizontal;
}

.half-col {
    width: 1fr;
    margin-right: 1;
}

#editor-actions {
    height: 3;
    layout: horizontal;
    align: right middle;
    margin-top: 1;
}

#editor-actions Button {
    margin-left: 1;
}

/* ==========================================================================
   Palette Screen Styles
   ========================================================================== */

#palette-dialog {
    width: 86;
    height: 28;
    background: $surface-darken-1;
    border: solid $primary;
    padding: 1 2;
    align: center middle;
}

#palette-title {
    text-style: bold;
    color: $primary;
    margin-bottom: 1;
    text-align: center;
}

#palette-search {
    width: 1fr;
    background: $surface;
    border: solid $primary-darken-2;
    margin-bottom: 1;
}

#palette-search:focus {
    border: solid $accent;
}

#palette-list {
    height: 10;
    background: $surface;
    border: solid $surface-darken-3;
    margin-bottom: 1;
}

#palette-list > .option-list--option-highlighted {
    background: $primary;
    color: $surface;
    text-style: bold;
}

#palette-detail-container {
    height: 7;
    background: $surface;
    border: solid $surface-darken-3;
    padding: 0 1;
    margin-bottom: 1;
}

#palette-detail-log {
    height: 100%;
    background: transparent;
    color: $text;
}

#palette-hint {
    text-align: center;
    color: $text-muted;
    text-style: italic;
}

/* ==========================================================================
   Safety Dialog Styles
   ========================================================================== */

#safety-dialog {
    width: 72;
    height: auto;
    background: $surface-darken-1;
    border: heavy $error;
    padding: 1 2;
    align: center middle;
}

#safety-title {
    text-style: bold;
    color: $error;
    text-align: center;
    margin-bottom: 1;
}

#safety-reason {
    color: $warning;
    text-style: italic;
    margin-bottom: 1;
}

#safety-command-box {
    background: $surface;
    border: solid $error-darken-2;
    padding: 1;
    margin-bottom: 1;
}

#safety-command-text {
    text-style: bold;
    color: $text;
}

#safety-prompt {
    color: $text-muted;
    margin-bottom: 1;
}

#safety-actions {
    height: 3;
    layout: horizontal;
    align: right middle;
}

#safety-actions Button {
    margin-left: 1;
}

/* ==========================================================================
   Settings Screen Styles
   ========================================================================== */

#settings-dialog {
    width: 76;
    height: auto;
    max-height: 92%;
    background: $surface-darken-1;
    border: solid $primary;
    padding: 1 2;
    align: center middle;
}

#settings-title {
    text-style: bold;
    color: $primary;
    text-align: center;
    margin-bottom: 1;
}

.settings-label {
    color: $text-muted;
    text-style: bold;
    margin-top: 1;
}

.settings-row {
    height: 3;
    margin-bottom: 1;
}

.settings-btn {
    width: 1fr;
    height: 3;
    border: none;
    background: $surface;
    color: $text;
    text-align: left;
}

.settings-btn:hover {
    background: $surface-lighten-1;
    color: $text;
}

#settings-actions {
    height: 3;
    layout: horizontal;
    align: right middle;
    margin-top: 1;
}

#settings-actions Button {
    margin-left: 1;
}
