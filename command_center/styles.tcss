/* Command Center - Clean, Modern Terminal UI Theme */

Screen {
    layout: vertical;
    background: $surface;
    color: $text;
}

#header-bar {
    dock: top;
    height: 3;
    background: $surface-darken-1;
    color: $text;
    padding: 0 1;
    border-bottom: solid $primary-darken-2;
    layout: horizontal;
    align: left middle;
}

#app-title {
    text-style: bold;
    color: $primary;
    margin-right: 2;
}

#app-subtitle {
    color: $text-muted;
}

#output-container {
    height: 1fr;
    background: $surface;
    padding: 1 1 0 1;
}

#output-log {
    height: 100%;
    background: $surface;
    color: $text;
    scrollbar-gutter: stable;
    overflow-y: scroll;
}

#status-bar {
    height: 1;
    dock: bottom;
    background: $surface-darken-2;
    color: $text;
    layout: horizontal;
    padding: 0 1;
}

.status-badge {
    margin-right: 1;
    text-style: bold;
}

#status-shell {
    color: $accent;
}

#status-cwd {
    color: $text-muted;
}

#status-exit {
    color: $text;
}

#status-state {
    color: $warning;
}

#input-container {
    dock: bottom;
    height: 3;
    layout: horizontal;
    background: $surface-darken-1;
    padding: 0 1;
    border-top: solid $primary-darken-2;
    align: left middle;
}

#prompt-symbol {
    width: 3;
    height: 1;
    color: $primary;
    text-style: bold;
    margin-top: 1;
}

#command-input {
    width: 1fr;
    background: transparent;
    border: none;
    color: $text;
    padding: 0;
}

#command-input:focus {
    border: none;
}

Footer {
    background: $surface-darken-3;
    color: $text-muted;
}

/* History Screen Styles */

#history-dialog {
    width: 100%;
    height: 100%;
    background: $surface;
    padding: 1;
}

#history-header {
    height: 3;
    layout: horizontal;
    align: left middle;
    margin-bottom: 1;
}

#history-title {
    width: 22;
    text-style: bold;
    color: $primary;
}

#history-search {
    width: 1fr;
    background: $surface-darken-1;
    border: solid $primary-darken-2;
    padding: 0 1;
}

#history-filter-bar {
    height: 3;
    layout: horizontal;
    margin-bottom: 1;
}

.filter-btn {
    margin-right: 1;
    min-width: 10;
    height: 3;
    border: none;
    background: $surface-darken-1;
    color: $text-muted;
}

.filter-btn:hover {
    background: $surface-lighten-1;
    color: $text;
}

.filter-btn.active {
    background: $primary;
    color: $text;
    text-style: bold;
}

#history-table-container {
    height: 1fr;
    border: solid $surface-darken-2;
    background: $surface;
    margin-bottom: 1;
}

#history-table {
    height: 100%;
    background: $surface;
}

#history-preview-container {
    height: 8;
    background: $surface-darken-1;
    border: solid $surface-darken-2;
    padding: 0 1;
}

#history-preview-title {
    text-style: bold;
    color: $text-muted;
    margin-bottom: 0;
}

#history-preview-log {
    height: 6;
    background: transparent;
    color: $text;
}

/* Auto-Suggest Dropdown Styles */

#bottom-dock {
    dock: bottom;
    height: auto;
}

#suggestions-container {
    display: none;
    max-height: 9;
    height: auto;
    background: $surface-darken-2;
    border-top: solid $primary-darken-2;
    border-bottom: solid $primary-darken-3;
    padding: 0;
}

#suggestions-container.visible {
    display: block;
}

#suggestions-list {
    background: transparent;
    border: none;
    height: auto;
    max-height: 8;
    padding: 0;
    scrollbar-gutter: stable;
}

#suggestions-list > .option-list--option-highlighted {
    background: $primary-darken-1;
    color: $text;
    text-style: bold;
}

/* Library Screen Styles */

#library-dialog {
    width: 100%;
    height: 100%;
    background: $surface;
    padding: 1;
}

#library-header {
    height: 3;
    layout: horizontal;
    align: left middle;
    margin-bottom: 1;
}

#library-title {
    width: 22;
    text-style: bold;
    color: $primary;
}

#library-search {
    width: 1fr;
    background: $surface-darken-1;
    border: solid $primary-darken-2;
    padding: 0 1;
}

#library-filter-bar {
    height: 3;
    layout: horizontal;
    margin-bottom: 1;
}

.lib-filter-btn {
    margin-right: 1;
    min-width: 12;
    height: 3;
    border: none;
    background: $surface-darken-1;
    color: $text-muted;
}

.lib-filter-btn:hover {
    background: $surface-lighten-1;
    color: $text;
}

.lib-filter-btn.active {
    background: $primary;
    color: $text;
    text-style: bold;
}

#btn-add-command {
    margin-left: 2;
}

#library-table-container {
    height: 1fr;
    border: solid $surface-darken-2;
    background: $surface;
    margin-bottom: 1;
}

#library-table {
    height: 100%;
    background: $surface;
}

#library-detail-container {
    height: 8;
    background: $surface-darken-1;
    border: solid $surface-darken-2;
    padding: 0 1;
}

#library-detail-title {
    text-style: bold;
    color: $text-muted;
}

#library-detail-log {
    height: 6;
    background: transparent;
    color: $text;
}

/* Editor Dialog Styles */

#editor-dialog {
    width: 70;
    height: auto;
    max-height: 90%;
    background: $surface-darken-1;
    border: solid $primary;
    padding: 1 2;
    align: center middle;
}

#editor-title {
    text-style: bold;
    color: $primary;
    margin-bottom: 1;
    text-align: center;
}

.field-label {
    color: $text-muted;
    margin-top: 1;
    text-style: bold;
}

.editor-row {
    height: auto;
    layout: horizontal;
}

.half-col {
    width: 1fr;
    margin-right: 1;
}

#editor-actions {
    height: 3;
    layout: horizontal;
    align: right middle;
    margin-top: 1;
}

#editor-actions Button {
    margin-left: 1;
}

/* Palette Screen Styles */

#palette-dialog {
    width: 84;
    height: 28;
    background: $surface-darken-1;
    border: solid $primary;
    padding: 1 2;
    align: center middle;
}

#palette-title {
    text-style: bold;
    color: $primary;
    margin-bottom: 1;
    text-align: center;
}

#palette-search {
    width: 1fr;
    background: $surface;
    border: solid $primary-darken-2;
    margin-bottom: 1;
}

#palette-list {
    height: 10;
    background: $surface;
    border: solid $surface-darken-2;
    margin-bottom: 1;
}

#palette-detail-container {
    height: 7;
    background: $surface;
    border: solid $surface-darken-2;
    padding: 0 1;
    margin-bottom: 1;
}

#palette-detail-log {
    height: 100%;
    background: transparent;
    color: $text;
}

#palette-hint {
    text-align: center;
    color: $text-muted;
    text-style: italic;
}

/* Safety Dialog Styles */

#safety-dialog {
    width: 70;
    height: auto;
    background: $surface-darken-1;
    border: solid $error;
    padding: 1 2;
    align: center middle;
}

#safety-title {
    text-style: bold;
    color: $error;
    text-align: center;
    margin-bottom: 1;
}

#safety-reason {
    color: $warning;
    text-style: italic;
    margin-bottom: 1;
}

#safety-command-box {
    background: $surface;
    border: solid $error-darken-2;
    padding: 1;
    margin-bottom: 1;
}

#safety-command-text {
    text-style: bold;
    color: $text;
}

#safety-prompt {
    color: $text-muted;
    margin-bottom: 1;
}

#safety-actions {
    height: 3;
    layout: horizontal;
    align: right middle;
}

#safety-actions Button {
    margin-left: 1;
}

/* Settings Screen Styles */

#settings-dialog {
    width: 74;
    height: auto;
    max-height: 92%;
    background: $surface-darken-1;
    border: solid $primary;
    padding: 1 2;
    align: center middle;
}

#settings-title {
    text-style: bold;
    color: $primary;
    text-align: center;
    margin-bottom: 1;
}

.settings-label {
    color: $text-muted;
    text-style: bold;
    margin-top: 1;
}

.settings-row {
    height: 3;
    margin-bottom: 1;
}

.settings-btn {
    width: 1fr;
    height: 3;
    border: none;
    background: $surface;
    color: $text;
    text-align: left;
}

.settings-btn:hover {
    background: $surface-lighten-1;
}

#settings-actions {
    height: 3;
    layout: horizontal;
    align: right middle;
    margin-top: 1;
}

#settings-actions Button {
    margin-left: 1;
}
